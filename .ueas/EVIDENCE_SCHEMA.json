{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ueas.local/schemas/evidence.schema.json",
  "title": "UEAS Evidence Envelope",
  "description": "Sobre de evidencia que todo agente UEAS entrega al cerrar su turno. La aprobación corresponde al VERIFIER o al humano, nunca al autor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "agent",
    "requirement",
    "risk",
    "confirmation",
    "changes",
    "verification",
    "evidence_completeness",
    "open_risks",
    "self_approved",
    "approvals"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identificador estable de la tarea."
    },
    "agent": {
      "type": "string",
      "enum": ["BUILDER", "VERIFIER", "ORCHESTRATOR"]
    },
    "requirement": {
      "type": "string",
      "minLength": 10,
      "description": "Requerimiento reformulado por el agente, no copiado literalmente."
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "justification"],
      "properties": {
        "level": { "type": "string", "enum": ["L1", "L2", "L3", "L4"] },
        "justification": { "type": "string", "minLength": 10 },
        "sensitive_data": { "type": "boolean" },
        "production": { "type": "boolean" },
        "critical_structures": { "type": "boolean" }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": {
          "type": "boolean",
          "description": "true para L2 o superior."
        },
        "status": {
          "type": "string",
          "enum": ["not_required", "pending", "granted", "denied"]
        },
        "granted_by": {
          "type": ["string", "null"],
          "description": "Identidad humana que autorizó. null si no aplica o está pendiente."
        }
      }
    },
    "changes": {
      "type": "array",
      "description": "Lista exhaustiva de archivos tocados. Vacía si no hubo cambios.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "action", "summary"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "enum": ["create", "modify", "delete"] },
          "summary": { "type": "string", "minLength": 5 }
        }
      }
    },
    "verification": {
      "type": "array",
      "description": "Comprobaciones ejecutadas o declaradas como no ejecutadas. Nunca omitir una comprobación fallida.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "method", "result"],
        "properties": {
          "check": { "type": "string", "minLength": 5 },
          "method": {
            "type": "string",
            "enum": ["command", "test_suite", "read_back", "schema_validation", "manual_inspection"]
          },
          "command": {
            "type": ["string", "null"],
            "description": "Comando reproducible. null solo si method no es ejecutable."
          },
          "result": { "type": "string", "enum": ["pass", "fail", "not_run"] },
          "output_excerpt": {
            "type": ["string", "null"],
            "description": "Salida literal o extracto. Obligatorio si result es pass o fail."
          },
          "not_run_reason": {
            "type": ["string", "null"],
            "description": "Obligatorio si result es not_run."
          }
        },
        "allOf": [
          {
            "if": { "properties": { "result": { "enum": ["pass", "fail"] } } },
            "then": {
              "required": ["output_excerpt"],
              "properties": { "output_excerpt": { "type": "string", "minLength": 1 } }
            }
          },
          {
            "if": { "properties": { "result": { "const": "not_run" } } },
            "then": {
              "required": ["not_run_reason"],
              "properties": { "not_run_reason": { "type": "string", "minLength": 1 } }
            }
          }
        ]
      }
    },
    "evidence_completeness": {
      "type": "string",
      "enum": ["complete", "partial", "none"],
      "description": "complete solo si todas las comprobaciones previstas se ejecutaron y constan."
    },
    "open_risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 5 },
      "description": "Riesgos conocidos y no mitigados. Vacío solo si no hay ninguno."
    },
    "rollback": {
      "type": ["string", "null"],
      "description": "Cómo deshacer los cambios. null solo para cambios aditivos triviales."
    },
    "self_approved": {
      "const": false,
      "description": "Constante false. Si un agente escribe true, la entrega es inválida por R1."
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "verifier": {
          "type": ["string", "null"],
          "description": "Debe ser distinto del agente autor."
        },
        "decision": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
