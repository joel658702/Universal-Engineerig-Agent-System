# Copiar a .env y rellenar. NUNCA versionar el .env real (R6).
# Sin valores por defecto para secretos: el servicio debe fallar si faltan.

NODE_ENV=
PORT=

# bearer | cookie | both
AUTH_MODE=
# Orígenes permitidos por CORS, separados por coma (vacío = solo mismo origen)
CORS_ALLOWED_ORIGINS=

DATABASE_URL=

# Identidad del emisor y audiencia de los tokens
JWT_ISSUER=
JWT_AUDIENCE=

# Claves asimétricas (EdDSA). Rutas a ficheros PEM fuera del repositorio.
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_KID=

# Duraciones ISO-8601
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=

# Límite de intentos de login
LOGIN_RATE_LIMIT_MAX=
LOGIN_RATE_LIMIT_WINDOW=
